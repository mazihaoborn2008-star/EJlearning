{
  "name": "ej-learning-35e1a1-local",
  "account_id": "bd05aa19111be95427af89be4e44f164",
  "main": "src/worker-35d1.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [],
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  },
  "secrets": {"required": ["DEEPSEEK_API_KEY"]},
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "351011",
    "simple": {"limit": 12, "period": 60}
  }, {
    "name": "AI_SHARED_RATE_LIMITER",
    "namespace_id": "351012",
    "simple": {"limit": 120, "period": 60}
  }],
  "assets": {
    "directory": "./public-35d1",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ej-learning-35e1a-local-db",
    "database_id": "00000000-0000-0000-0000-000000035e1a",
    "migrations_dir": "migrations-35e1a1"
  }, {
    "binding": "CONTENT_DB",
    "database_name": "ej-learning-35e1a-local-db",
    "database_id": "00000000-0000-0000-0000-000000035e1a"
  }]
}
