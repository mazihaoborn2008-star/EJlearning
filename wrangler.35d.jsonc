{
  "name": "ej-learning-35d",
  "account_id": "bd05aa19111be95427af89be4e44f164",
  "main": "src/worker-35d.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [],
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  },
  "secrets": {
    "required": ["DEEPSEEK_API_KEY"]
  },
  "assets": {
    "directory": "./public-35d",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ej-learning-35d-db",
    "database_id": "2cd594d3-cab0-4715-a154-9ea3d099c4c7",
    "migrations_dir": "migrations-35d-bundle"
  }, {
    "binding": "CONTENT_DB",
    "database_name": "ej-learning-35c1-db",
    "database_id": "3bf1fc19-e5ce-4521-b051-94f91fedfd82"
  }]
}
