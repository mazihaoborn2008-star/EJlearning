{
  "name": "ej-learning-35e1c",
  "account_id": "bd05aa19111be95427af89be4e44f164",
  "main": "src/worker-35d1.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [],
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  },
  "secrets": {
    "required": ["DEEPSEEK_API_KEY"]
  },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "351001",
    "simple": {"limit": 12, "period": 60}
  }, {
    "name": "AI_SHARED_RATE_LIMITER",
    "namespace_id": "351002",
    "simple": {"limit": 120, "period": 60}
  }],
  "assets": {
    "directory": "./public-35d1",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ej-learning-35e1c-db",
    "database_id": "cc71642a-13e5-4a94-92c9-34372d8cbf3b",
    "migrations_dir": "migrations-35e1c"
  }, {
    "binding": "CONTENT_DB",
    "database_name": "ej-learning-35e1c-db",
    "database_id": "cc71642a-13e5-4a94-92c9-34372d8cbf3b"
  }]
}
