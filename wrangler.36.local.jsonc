{
  "name": "ej-learning-36-local",
  "main": "src/worker-36.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "DEEPSEEK_API_KEY": "local-test-only"
  },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "360001",
    "simple": {"limit": 12, "period": 60}
  }, {
    "name": "AI_SHARED_RATE_LIMITER",
    "namespace_id": "360002",
    "simple": {"limit": 120, "period": 60}
  }],
  "kv_namespaces": [{"binding": "AI_SESSIONS", "id": "local-ai-sessions"}],
  "assets": {
    "directory": "./public-36",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ej-learning-36-local-db",
    "database_id": "00000000-0000-0000-0000-000000000036",
    "migrations_dir": "migrations-staging-schema"
  }, {
    "binding": "CONTENT_DB",
    "database_name": "ej-learning-36-local-db",
    "database_id": "00000000-0000-0000-0000-000000000036"
  }]
}
