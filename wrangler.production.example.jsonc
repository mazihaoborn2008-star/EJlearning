{
  "$schema": "node_modules/wrangler/config-schema.json",
  // REVIEW ONLY. No service/route has been created. Copy to wrangler.production.jsonc
  // only when production deployment is authorized again.
  "name": "ej-learning",
  "account_id": "bd05aa19111be95427af89be4e44f164",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "routes": [{"pattern": "ej_learning.jwcglass.com/*", "zone_name": "jwcglass.com"}],
  "assets": {
    "directory": "./public", "binding": "ASSETS",
    "html_handling": "none", "not_found_handling": "none",
    "run_worker_first": ["/", "/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "ej-learning-db",
    "database_id": "e2e8f4c8-27e0-416e-993c-7510259a6b1d",
    "migrations_dir": "migrations"
  }]
}
