  "assets": {"directory":"./public-35d1","binding":"ASSETS","html_handling":"none","not_found_handling":"none","run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"ej-learning-35e1b-local-db","database_id":"00000000-0000-0000-0000-000000035e1b","migrations_dir":"migrations-35e1b"},{"binding":"CONTENT_DB","database_name":"ej-learning-35e1b-local-db","database_id":"00000000-0000-0000-0000-000000035e1b"}]
